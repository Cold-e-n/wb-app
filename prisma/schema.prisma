// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma-generated"
}

datasource db {
  provider = "postgresql"
}

model Color {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(200)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("colors")
}

model ColorLayout {
  id           String    @id @default(cuid())
  fabricId     String    @unique @map("fabric_id")
  colorContent Json?     @map("color_content")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  fabric         Fabric          @relation(fields: [fabricId], references: [id])
  colorPositions ColorPosition[]

  @@map("color_layouts")
}

model ColorPosition {
  id            String    @id @default(cuid())
  fabricId      String    @map("fabric_id")
  colorLayoutId String    @map("color_layout_id")
  fabricContent Json?     @map("fabric_content")
  wbNo          String    @map("wb_no")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  fabric      Fabric      @relation(fields: [fabricId], references: [id])
  colorLayout ColorLayout @relation(fields: [colorLayoutId], references: [id])

  @@map("color_positions")
}

model Fabric {
  id       String  @id @default(cuid())
  name     String  @unique @db.VarChar(100)
  slug     String  @unique @db.VarChar(200)
  hasColor Boolean @default(false) @map("has_color")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  colorLayout    ColorLayout?
  colorPositions ColorPosition[]
  fabricSpecs    FabricSpec[]

  @@map("fabrics")
}

model FabricSpec {
  id       String @id @default(cuid())
  fabricId String @map("fabric_id")

  width          Int     @map("width")
  length         Int     @map("length")
  warpYarnId     String  @map("warp_yarn_id")
  weftYarnId     String  @map("weft_yarn_id")
  color          String? @map("color")
  cutmarkPerRoll Json    @map("cutmark_per_roll")
  totalEnds      Int     @map("total_ends")
  reedWidth      Decimal @map("reed_width") @db.Decimal(8, 2)
  reedNo         String  @map("reed_no")
  fringe         Int?    @map("fringe")
  pickPerInch    Int     @map("pick_per_inch")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  fabric              Fabric               @relation(fields: [fabricId], references: [id])
  fabricConstructions FabricConstruction[]
  warpYarn            Yarn                 @relation("warpYarnRelation", fields: [warpYarnId], references: [id])
  weftYarn            Yarn                 @relation("weftYarnRelation", fields: [weftYarnId], references: [id])

  @@unique([fabricId, width, length, warpYarnId, weftYarnId])
  @@map("fabric_specs")
}

model FabricConstruction {
  id           String @id @default(cuid())
  fabricSpecId String @map("fabric_spec_id")

  rollCount      Int           @map("roll_count")
  warpingMachine WbMachineType @map("warping_machine")
  coneCount      Int           @map("cone_count")
  sectionCount   Int           @map("section_count")
  sectionLength  Int           @map("section_length")
  beamWidth      Decimal       @map("beam_width") @db.Decimal(8, 2)
  spareEnds      Int           @map("spare_ends")
  beamingLoss    Int?          @map("beaming_loss")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  fabricSpec FabricSpec @relation(fields: [fabricSpecId], references: [id])

  @@map("fabric_constructions")
}

model WeavingMachine {
  id    String @id @default(cuid())
  name  String @unique @db.VarChar(100)
  slug  String @unique @db.VarChar(200)
  width Int
  type  String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("weaving_machines")
}

model Yarn {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(200)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  warpFabricSpecs FabricSpec[] @relation("warpYarnRelation")
  weftFabricSpecs FabricSpec[] @relation("weftYarnRelation")

  @@map("yarns")
}

enum WbMachineType {
  BENNINGER
  KARLMAYER
  MO
  TSUDAKOMA
}

enum WbProcessType {
  WARPING
  BEAMING
}
