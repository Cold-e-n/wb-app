// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma-generated"
}

datasource db {
  provider = "postgresql"
}

model Color {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(200)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("colors")
}

model ColorLayout {
  id           String    @id @default(cuid())
  fabricId     String    @unique @map("fabric_id")
  colorContent Json?     @map("color_content")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  fabric         Fabric          @relation(fields: [fabricId], references: [id])
  colorPositions ColorPosition[]

  @@map("color_layouts")
}

model ColorPosition {
  id            String    @id @default(cuid())
  fabricId      String    @map("fabric_id")
  colorLayoutId String    @map("color_layout_id")
  fabricContent Json?     @map("fabric_content")
  wbNo          String    @map("wb_no")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  fabric      Fabric      @relation(fields: [fabricId], references: [id])
  colorLayout ColorLayout @relation(fields: [colorLayoutId], references: [id])

  @@map("color_positions")
}

model Fabric {
  id             String          @id @default(cuid())
  name           String          @unique @db.VarChar(100)
  slug           String          @unique @db.VarChar(200)
  hasColor       Boolean         @default(false) @map("has_color")
  colorLayoutId  String?         @map("color_layout_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime?       @map("updated_at")
  colorLayout    ColorLayout?
  colorPositions ColorPosition[]

  @@map("fabrics")
}

model WeavingMachine {
  id    String @id @default(cuid())
  name  String @unique @db.VarChar(100)
  slug  String @unique @db.VarChar(200)
  width Int
  type  String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("weaving_machines")
}

model Yarns {
  id   String @id @default(cuid())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(200)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@map("yarns")
}

enum WbMachineType {
  BENNINGER
  KARLMAYER
  MO
  TSUDAKOMA
}

enum WbProcessType {
  WARPING
  BEAMING
}
